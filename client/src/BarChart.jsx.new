import { Bar } from "react-chartjs-2";
import ChartDataLabels from "chartjs-plugin-datalabels";
import "chartjs-adapter-date-fns";

import {
  Chart as ChartJS,
  CategoryScale,
  LinearScale,
  BarElement,
  TimeScale,
  Title,
  Tooltip,
  Legend,
} from "chart.js";

const legendSpacingPlugin = {
  id: "legendSpacing",
  beforeInit(chart) {
    const legend = chart.legend;

    if (!legend) return;

    const originalFit = legend.fit;

    legend.fit = function fit() {
      originalFit.call(this);
      this.height += 50;
    };
  },
};

ChartJS.register(
  CategoryScale,
  LinearScale,
  BarElement,
  TimeScale,
  Title,
  Tooltip,
  Legend,
  ChartDataLabels,
  legendSpacingPlugin,
);

export const BarChart = ({ data, options }) => {
  return <Bar data={data} options={options} />;
};
